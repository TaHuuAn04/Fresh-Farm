#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*) basedir=`cygpath -w "$basedir"`;;
esac

if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../../replace-in-file@3.4.4/node_modules/replace-in-file/bin/cli.js" "$@"
else
  exec node  "$basedir/../../../../../replace-in-file@3.4.4/node_modules/replace-in-file/bin/cli.js" "$@"
fi
